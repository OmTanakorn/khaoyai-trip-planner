rules_version = '2';

/*
 * Nobody signs up for this trip, so there is no account to check against.
 * Every browser takes an anonymous identity instead (see `authReady` in
 * src/services/storage.ts), which is enough to close the door on the open
 * internet — the project id ships in a public repo — without putting a login
 * screen in front of friends who were handed a link.
 *
 * This is a lock, not a vault: anyone holding the public config can mint an
 * anonymous identity too. What it buys is that the trip cannot be scraped or
 * wiped by something that never opened the app.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Legacy slips are base64 in the document. Keep them under the 1 MiB
    // ceiling; slips written since the bucket exists carry only a url.
    function isTripList(name) {
      return name in [
        'members', 'cars', 'accommodationOptions', 'placeIdeas', 'menuIdeas',
        'itinerary', 'expenses', 'payments', 'packingList', 'announcements'
      ];
    }

    function slipIsSmall() {
      return !('image' in request.resource.data)
        || request.resource.data.image.size() < 900000;
    }

    match /trips/{tripId} {
      allow read: if signedIn();

      // The document holds only what describes the trip as a whole. Every
      // list lives in a subcollection below, one item per document, so a save
      // here cannot reach anybody's expenses or members.
      allow create, update: if signedIn()
        && request.resource.data.id == tripId
        && request.resource.data.title is string;

      // Nothing in the app deletes a trip, so nothing may.
      allow delete: if false;

      match /slips/{slipId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && slipIsSmall();
        allow delete: if signedIn();
      }

      // One document per item: an expense, a member, a packing item. A write
      // names a single one of them, which is what stops a device holding an
      // older copy from taking away what everybody else added.
      //
      // Named rather than matched by wildcard: rules combine with OR, so a
      // `/{anything}/{id}` rule here would also grant slips and quietly undo
      // the size limit that keeps a base64 photo under the document ceiling.
      match /{list}/{itemId} {
        allow read: if signedIn() && isTripList(list);
        allow create, update: if signedIn()
          && isTripList(list)
          && request.resource.data.size() < 200;
        allow delete: if signedIn() && isTripList(list);
      }
    }

    // The app touches nothing outside a trip.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
